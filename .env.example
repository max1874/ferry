# Copy this file to .env next to compose.yaml, then edit it.

# Ferry image. To upgrade, back up first, then change only the version after the colon.
FERRY_IMAGE=ghcr.io/max1874/ferry:1.0.1

# Host address Docker publishes Ferry on. 127.0.0.1 reaches Ferry from this
# computer only. For your phone and other computers, replace it with this
# server's private LAN IP, for example 192.168.1.20.
FERRY_HOST_IP=127.0.0.1
FERRY_PORT=42817

# Optional. The origin of your own TLS reverse proxy inside a private network,
# for example https://ferry.example.com. Leave empty without a proxy.
FERRY_TRUSTED_ORIGIN=

# Optional. The listener inside the container. Empty uses the container's only
# IP; set 0.0.0.0 when the container also joins another Docker network.
FERRY_LISTEN_HOST=
